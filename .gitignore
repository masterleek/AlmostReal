# Godot 4+ : cache local régénéré automatiquement à l'ouverture du projet
# (miniatures, ressources importées, etc.) — jamais à versionner.
.godot/

# Traductions générées automatiquement depuis des CSV
*.translation

# macOS
.DS_Store

# Éditeur de maps (Node.js) : dépendances régénérées via `npm install`
tools/MapEditor/node_modules/

# Export web : artefact de build régénéré via --export-release "Web",
# jamais à versionner (cf export_presets.cfg pour la config elle-même).
web_export/
